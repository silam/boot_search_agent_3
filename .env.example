# ---- copy to .env and adjust ----
ENVIRONMENT=local
LOG_LEVEL=INFO

# Embeddings: "lite" (no torch, fast, lexical) or "clip" (sentence-transformers + OpenCLIP)
EMBEDDING_BACKEND=lite

# Vector DB: ":memory:" (embedded), "path:./qdrant_data" (embedded, persisted),
# "http://localhost:6333" (Docker), or your Qdrant Cloud URL + key
QDRANT_URL=:memory:
QDRANT_API_KEY=

# LLM (optional — without a key the agent uses rule-based understanding + template answers)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Set to your model's current list price (USD per 1M tokens) for accurate cost metrics
LLM_INPUT_COST_PER_MTOK=1.0
LLM_OUTPUT_COST_PER_MTOK=5.0

# Cache (optional) — falls back to in-memory
REDIS_URL=

# SQL store for search logs + feedback (SQLite locally, Postgres in prod)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/boots

# API security
API_KEY=
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*

# UI -> API
API_URL=http://localhost:8000
